{
  "name": "zClip",
  "version": "2.5.1",
  "private": true,
  "description": "本地、离线、无订阅的 Windows 视频剪辑器",
  "author": "zJay26",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zJay26/zClip.git"
  },
  "bugs": {
    "url": "https://github.com/zJay26/zClip/issues"
  },
  "homepage": "https://github.com/zJay26/zClip#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:ui": "vitest run",
    "test": "npm run typecheck && vitest run",
    "prepare:electron": "node ./node_modules/electron/install.js",
    "prepare:ffmpeg": "node ./scripts/prepare-ffmpeg.mjs",
    "check:native": "node ./scripts/check-native-tools.mjs",
    "check:packaged": "node ./scripts/check-packaged-app.mjs",
    "docs:assets": "node ./scripts/capture-readme-assets.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "audit:prod": "npm run audit:dependencies",
    "check": "npm test && npm run audit:dependencies && npm run check:native && npm run build",
    "test:ui:update": "vitest run -u",
    "readme:generate": "node ./scripts/generate-readme.mjs",
    "release:prepare": "npm run readme:generate && npm run check",
    "postinstall": "npm run prepare:electron && npm run prepare:ffmpeg && electron-builder install-app-deps",
    "dist": "electron-builder --publish never",
    "pack:dir": "electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "7zip-bin": "5.2.0",
    "@axe-core/react": "^4.12.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@rolldown/binding-win32-x64-msvc": "^1.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "postcss": "^8.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "@electron/fuses": "2.1.3",
    "@babel/core": "^7.29.7",
    "form-data": "^4.0.6",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "picomatch@2.3.1": "2.3.2",
    "tmp": "0.2.7",
    "undici": "7.29.0",
    "node-gyp": {
      "undici": "6.28.0"
    },
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "rollup": "^4.62.2"
  },
  "build": {
    "appId": "com.zClip",
    "productName": "zClip",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "fileAssociations": [
      {
        "ext": "zclip",
        "name": "zClip Project",
        "description": "zClip project file",
        "role": "Editor"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "!out/*.tsbuildinfo",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "build/zClip.ico",
        "to": "zClip.ico"
      },
      {
        "from": "build/ffmpeg/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "build/ffmpeg/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      },
      {
        "from": "build/ffmpeg/LICENSE",
        "to": "ffmpeg/LICENSE"
      },
      {
        "from": "build/ffmpeg/README.txt",
        "to": "ffmpeg/README.txt"
      },
      {
        "from": "build/ffmpeg/SOURCE.json",
        "to": "ffmpeg/SOURCE.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "zClip.Setup.${version}.${ext}",
      "icon": "build/zClip.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
