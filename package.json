{
  "name": "zClip",
  "version": "2.4.0",
  "description": "极简 Windows 视频剪辑工具",
  "author": "zJay26",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zJay26/zClip.git"
  },
  "bugs": {
    "url": "https://github.com/zJay26/zClip/issues"
  },
  "homepage": "https://github.com/zJay26/zClip#readme",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:web && npm run typecheck:node",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "test:ui": "vitest run",
    "test": "npm run typecheck && vitest run",
    "check": "npm run typecheck && vitest run && npm run build",
    "test:ui:update": "vitest run -u",
    "readme:generate": "node ./scripts/generate-readme.mjs",
    "release:prepare": "npm run readme:generate",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "soundtouchjs": "^0.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/react": "^4.12.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@rolldown/binding-win32-x64-msvc": "^1.1.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "form-data": "^4.0.6",
    "picomatch@2.3.1": "2.3.2",
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "rollup": "^4.62.2"
  },
  "build": {
    "appId": "com.zClip",
    "productName": "zClip",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "zClip.Setup.${version}.${ext}",
      "icon": "build/zClip.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
